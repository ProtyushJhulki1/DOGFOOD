<!DOCTYPE html>
<html>
<head>
  <title>Pairwise Comparisons</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <nav>
    <div class="brand">
      <div class="brand-mark">🦖</div>
      <span class="brand-name">Hackathon Raptors</span>
    </div>
    <span class="brand-tagline">a coder's dream</span>
    <div class="links">
      <a href="/judge">Dashboard</a>
      <a href="/logout">Logout</a>
    </div>
  </nav>
  <div class="container">
    <div class="section-eyebrow">// PAIRWISE</div>
    <h1 class="page-title">Pick the Stronger Project</h1>
    <% if (!events.length) { %>
      <p style="color:var(--muted);">No event has pairwise comparisons open for you right now.</p>
    <% } %>
    <div class="project-grid">
      <% events.forEach(function (e) { %>
        <div class="card">
          <div class="card-top"><h3><%= e.name %></h3></div>
          <div class="card-meta"><span></span><a href="/judge/pairwise/<%= encodeURIComponent(e.id) %>">Start →</a></div>
        </div>
      <% }); %>
    </div>
  </div>
</body>
</html>
