<!DOCTYPE html>
<html>
<head>
  <%- include('partials/head-assets') %>
  <title><%= event.name %> — Dogfood Platform</title>
</head>
<body>
  <nav>
    <div class="brand">
      <div class="brand-mark">🦖</div>
      <span class="brand-name">Hackathon Raptors</span>
    </div>
    <span class="brand-tagline">a coder's dream</span>
    <div class="links">
      <a href="/projects">Gallery</a>
      <a href="/events">Events</a>
      <% if (auth) { %>
        <a href="/dashboard">Dashboard</a>
        <a href="/logout">Logout</a>
      <% } else { %>
        <a href="/login" class="cta">Log In</a>
      <% } %>
    </div>
  </nav>

  <section class="hero">
    <div class="hero-inner">
            <div class="live-badge">
        <span class="pulse-dot"></span>
        <%= scoreCount %> scores logged, <%= judgeCount %> judges active
      </div>

      <h1><%= event.name %><br><span class="accent">Judged in the open.</span></h1>
      <p class="tagline">A self-hostable submission and judging platform — <b>built to run the event that's grading it</b>. Every access rule enforced server-side, nothing hidden by the UI.</p>

      <div class="carousel">
        <div class="carousel-track" id="carouselTrack">
          <div class="carousel-slide">
            <div class="icon">🦖</div>
            <h4>One platform, every event</h4>
            <p>Built to run any Hackathon Raptors event — not a one-off demo, but the real submission and judging engine for their next 35+ hackathons.</p>
          </div>
          <div class="carousel-slide">
            <div class="icon">🌍</div>
            <h4>85+ countries, one codebase</h4>
            <p>Hackathon Raptors runs events across the globe. This platform is self-hostable and dependency-free by design, so it deploys the same way everywhere.</p>
          </div>
          <div class="carousel-slide">
            <div class="icon">✅</div>
            <h4>Verified, not just claimed</h4>
            <p>Every access rule in this build — judge isolation, deadline enforcement, exports — is enforced server-side and checked by an automated acceptance suite.</p>
          </div>
        </div>
        <div class="carousel-dots" id="carouselDots"></div>
      </div>

      <div class="hero-actions">

   
        <a href="/projects" class="btn btn-primary">Browse Projects →</a>
        <a href="/login" class="btn btn-outline">Log In</a>
      </div>

      <div class="tier-label">— TIER VERIFICATION STATUS —</div>
      <div class="tier-ladder">
        <div class="rung rung--verified">
          <span class="rung-id">T1</span>
          <span class="rung-track"><span class="rung-fill" style="animation-delay:100ms"></span></span>
          <span class="rung-status">VERIFIED</span>
        </div>
        <div class="rung rung--verified">
          <span class="rung-id">T2</span>
          <span class="rung-track"><span class="rung-fill" style="animation-delay:350ms"></span></span>
          <span class="rung-status">VERIFIED</span>
        </div>
        <div class="rung rung--pending">
          <span class="rung-id">T3</span>
          <span class="rung-track"><span class="rung-fill"></span></span>
          <span class="rung-status">—</span>
        </div>
        <div class="rung rung--pending">
          <span class="rung-id">T4</span>
          <span class="rung-track"><span class="rung-fill"></span></span>
          <span class="rung-status">—</span>
        </div>
      </div>
    </div>
  </section>

  <% if (tickerRows.length) { %>
  <div class="ticker">
    <div class="ticker-track">
      <% [...tickerRows, ...tickerRows].forEach(t => { %>
        <span>💬 "<%= t.comment %>" — on <%= t.title %></span>
      <% }); %>
    </div>
  </div>
  <% } %>

  <section class="stats">
    <div class="stats-grid">
      <div><div class="num" data-count="<%= projectCount %>">0</div><div class="lbl">Projects Submitted</div></div>
      <div><div class="num" data-count="<%= judgeCount %>">0</div><div class="lbl">Judges Seated</div></div>
      <div><div class="num">7/7</div><div class="lbl">Checks Passing</div></div>
    </div>
  </section>

</body>
</html>