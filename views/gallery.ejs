<!DOCTYPE html>
<html>
<head>
    <%- include('partials/head-assets') %>
  <title>Project Gallery — Dogfood Platform</title>
</head>
<body>
    <nav>
    <div class="brand">
      <div class="brand-mark">🦖</div>
      <span class="brand-name">Hackathon Raptors</span>
    </div>
    <span class="brand-tagline">a coder's dream</span>
    <div class="links">
      <a href="/">Home</a>
      <a href="/events">Events</a>
      <% if (auth) { %>
        <a href="/dashboard">Dashboard</a>
        <a href="/logout">Logout</a>
      <% } else { %>
        <a href="/login" class="cta">Log In</a>
      <% } %>
    </div>
  </nav>

  <div class="container">
    <div class="section-eyebrow">// ALL SUBMISSIONS</div>
    <h1 class="page-title">Project Gallery</h1>

    <input type="text" id="searchBox" placeholder="Search by title, team, or track…" class="search-box">
    <div class="track-pills" id="trackPills">
      <button class="track-pill active" data-track="">All tracks</button>
    </div>

    <div class="project-grid" id="projectList">
      <% projects.forEach(p => { %>
        <div class="card project-card" data-track="<%= p.track_name || '' %>">
          <div class="card-top">
            <h3><%= p.title %></h3>
            <% if (p.track_name) { %>
              <span class="badge" style="color:#a78bfa;border-color:rgba(167,139,250,0.4);background:rgba(167,139,250,0.08);"><%= p.track_name %></span>
            <% } %>
          </div>
          <p><%= p.summary %></p>
          <div class="card-meta">
            <span><%= p.team_name || '—' %></span>
            <% if (p.repo_url) { %><a href="<%= p.repo_url %>" target="_blank">View Repo →</a><% } %>
          </div>
        </div>
      <% }); %>
    </div>
  </div>

  <script>
    const cards = Array.from(document.querySelectorAll('.project-card'));
    const searchBox = document.getElementById('searchBox');
    const pillsWrap = document.getElementById('trackPills');

    const tracks = [...new Set(cards.map(c => c.dataset.track).filter(Boolean))].sort();
    tracks.forEach(t => {
      const btn = document.createElement('button');
      btn.className = 'track-pill';
      btn.dataset.track = t;
      btn.textContent = t;
      pillsWrap.appendChild(btn);
    });

    let activeTrack = '';
    function applyFilters() {
      const q = searchBox.value.toLowerCase();
      cards.forEach(card => {
        const matchesTrack = !activeTrack || card.dataset.track === activeTrack;
        const matchesSearch = card.textContent.toLowerCase().includes(q);
        card.style.display = (matchesTrack && matchesSearch) ? '' : 'none';
      });
    }

    pillsWrap.addEventListener('click', (e) => {
      if (e.target.tagName !== 'BUTTON') return;
      activeTrack = e.target.dataset.track;
      pillsWrap.querySelectorAll('.track-pill').forEach(b => b.classList.remove('active'));
      e.target.classList.add('active');
      applyFilters();
    });

    searchBox.addEventListener('input', applyFilters);
  </script>
</body>
</html>