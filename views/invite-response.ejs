<!DOCTYPE html>
<html>
<head>
    <%- include('partials/head-assets') %>
  <title>Team Invite</title>
</head>
<body>
  <div class="login-wrap">
    <div class="login-box">
      <% if (!invite) { %>
        <h1>Invalid Invite</h1>
        <p>This invite link doesn't exist or has expired.</p>
      <% } else if (invite.status !== 'pending') { %>
        <h1>Invite <%= invite.status %></h1>
        <p>This invite has already been <%= invite.status %>.</p>
      <% } else if (!auth) { %>
        <h1><%= invite.team_name %></h1>
        <p>You've been invited to join this team for <%= invite.event_name %>. Log in or sign up as <b><%= invite.invited_email %></b> to respond.</p>
        <a href="/login" class="btn btn-primary" style="width:100%;display:block;text-align:center;margin-top:1rem;">Log In</a>
        <a href="/signup" class="btn btn-outline" style="width:100%;display:block;text-align:center;margin-top:0.75rem;">Sign Up</a>
      <% } else { %>
        <h1><%= invite.team_name %></h1>
        <p>You've been invited to join this team for <%= invite.event_name %>.</p>
        <form method="POST" action="/invite/<%= invite.token %>/accept" style="margin-top:1rem;">
          <button type="submit" class="btn btn-primary" style="width:100%;">Accept Invite</button>
        </form>
        <form method="POST" action="/invite/<%= invite.token %>/reject" style="margin-top:0.75rem;">
          <button type="submit" class="btn btn-outline" style="width:100%;">Decline</button>
        </form>
      <% } %>
    </div>
  </div>
</body>
</html>